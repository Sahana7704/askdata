# Copy to backend/.env and fill in. All variables are prefixed ASKDATA_.
ASKDATA_ANTHROPIC_API_KEY=
ASKDATA_MODEL=claude-sonnet-5-5
# OR use Google Gemini (free tier): get a key at https://aistudio.google.com/apikey
ASKDATA_GEMINI_API_KEY=
ASKDATA_GEMINI_MODEL=gemini-flash-latest
ASKDATA_GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Use the READ-ONLY role created by data/seed.py
ASKDATA_DATABASE_URL=postgresql+psycopg://askdata_ro:askdata_ro@localhost:5432/shop
ASKDATA_CORS_ORIGINS=http://localhost:3000
ASKDATA_MAX_REPAIRS=2
ASKDATA_ROW_LIMIT=1000
ASKDATA_STATEMENT_TIMEOUT_MS=8000
